{
  "name": "friend-agent-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "ruodou233 & shing19",
  "contributors": [
    "ruodou233",
    "shing19"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:claude": "vite --mode claude",
    "dev:codex": "vite --mode codex",
    "build:claude": "vite build --mode claude --outDir dist/claude",
    "build:codex": "vite build --mode codex --outDir dist/codex",
    "desktop:build:claude": "bash scripts/build-macos.sh",
    "desktop:build:codex": "node -e \"const {spawnSync}=require('node:child_process'); const interpreter=process.platform==='win32'?'python':'python3'; const result=spawnSync(interpreter,['scripts/verify-release-support.py','--product','codex','--system','macos','--action','build'],{stdio:'inherit'}); process.exit(result.error ? 1 : (result.status ?? 1));\"",
    "desktop:build:macos": "bash scripts/build-macos.sh",
    "desktop:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "test:release": "node -e \"const {spawnSync}=require('node:child_process'); const interpreter=process.platform==='win32'?'python':'python3'; const result=spawnSync(interpreter,['tests/test_release_gate.py'],{stdio:'inherit'}); process.exit(result.error ? 1 : (result.status ?? 1));\"",
    "test": "npm run test:release && npm run build:claude && npm run build:codex && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "vite": "7.3.6"
  }
}
