# Copy to .env on the VPS and replace every replace-with-* value out of band.
# This example deliberately contains no real domain, account, password, API key, or certificate.
COMPOSE_PROJECT_NAME=friend-v1a-template
PUBLIC_HOST=replace-with-approved-domain.invalid
NEW_API_IMAGE=replace-with-reviewed-new-api-image
NEW_API_PORT=3000
NEW_API_UPSTREAM_PROVIDER=LowcostAI
FRIEND_GATEWAY_MODE=mock
FRIEND_GATEWAY_PORT=3100
FRIEND_GATEWAY_CATALOG_FILE=/app/config/catalog.json
FRIEND_GATEWAY_KEY_BINDINGS_FILE=/app/config/key-bindings.json
FRIEND_GATEWAY_UPSTREAM_BASE_URL=http://new-api:3000
FRIEND_GATEWAY_BALANCE_ADAPTER_URL=http://new-api:3000/internal/friend/balance-reference
MYSQL_DATABASE=new_api
MYSQL_USER=new_api
MYSQL_PASSWORD=replace-with-runtime-secret
MYSQL_ROOT_PASSWORD=replace-with-runtime-secret
NEW_API_SESSION_SECRET=replace-with-runtime-secret
BACKUP_DIR=/var/backups/friend-v1a
